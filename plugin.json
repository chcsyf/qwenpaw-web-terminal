{
  "id": "qwenpaw-web-terminal",
  "name": "Web 终端",
  "version": "0.1.3",
  "description": "浏览器终端窗口插件 v0.1.3：多标签（每标签独立 PTY，关闭标签即结束终端）+ xterm.js 渲染（ANSI/光标/Tab 补全/复制粘贴）+ 单条命令执行（exec）+ WebSocket 交互式 PTY + 会话持久化（刷新/断网后台保留，可重新 attach 完整历史）+ 会话管理面板（查看/打开/结束/清理，同名新建自动打开、打开所有会话）+ 多会话 + 自动重连 + 惰性连接（智能体同名默认标签）",
  "author": "QwenPaw QA Agent",
  "license": "Apache-2.0",
  "type": "app",
  "qwenpaw_version": {
    "min": "2.0.0",
    "max": "2.1.0"
  },
  "entry": {
    "backend": "plugin.py",
    "frontend": "ui/index.js"
  },
  "menu": {
    "label": "终端",
    "icon": "🖥️",
    "description": "浏览器终端窗口",
    "location": "primary.settings"
  },
  "permissions": [
    "workspace.write"
  ],
  "meta": {
    "category": "developer-tools",
    "icon": "🖥️",
    "pawapp": {
      "icon": "🖥️",
      "category": "developer-tools",
      "entry_page": "/apps/qwenpaw-web-terminal",
      "launch_scope": "page"
    }
  },
  "repository": "https://gitee.com/archigram/qwenpaw-web-terminal"
}
